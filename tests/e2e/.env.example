# Product hosts are deployment inputs; local tests may override them with *.localhost.
GLOBAL_HOST=global.e2e.gizclaw.test
CN_HOST=cn.e2e.gizclaw.test
AUTH_HOST=identity.e2e.gizclaw.test
PAY_HOST=pay.e2e.gizclaw.test

# TLS is owned by the E2E caller. Supply a currently valid certificate/key pair whose SANs cover
# global.e2e.gizclaw.test, cn.e2e.gizclaw.test, identity.e2e.gizclaw.test, and pay.e2e.gizclaw.test.
# Compose mounts the files read-only; no release image contains or requests a certificate.
TLS_CERT_FILE=/absolute/path/to/e2e-tls.crt
TLS_KEY_FILE=/absolute/path/to/e2e-tls.key
