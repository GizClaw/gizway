{
  "name": "gizway",
  "version": "0.3.0",
  "description": "Official JavaScript SDK for GizWay",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GizClaw/gizway.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "files": ["dist", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:package": "node --test tests/package.test.mjs",
    "test:e2e": "playwright test",
    "test:publish": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:package",
    "prepublishOnly": "npm run test:publish"
  },
  "dependencies": {
    "@journeyapps/wa-sqlite": "2.0.3",
    "@powersync/web": "2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.55.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  },
  "overrides": { "ws": "8.21.0" }
}
