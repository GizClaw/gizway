tls:
  options:
    default:
      sniStrict: true
  certificates:
    - certFile: "@@TLS_CERT_FILE@@"
      keyFile: "@@TLS_KEY_FILE@@"
http:
  routers:
    ai:
      rule: Host(`@@CN_HOST@@`) && (PathPrefix(`/openai/`) || PathPrefix(`/anthropic/`) || PathPrefix(`/genai/`))
      priority: 200
      entryPoints: [websecure]
      tls: {}
      middlewares: [browser-cors]
      service: gizway
    auth-user:
      rule: Host(`@@CN_HOST@@`) && (Path(`/auth/runtime-config`) || Path(`/auth/catalog-token`) || PathPrefix(`/user/v1/`))
      priority: 190
      entryPoints: [websecure]
      tls: {}
      middlewares: [browser-cors]
      service: gizway
    account:
      rule: Host(`@@CN_HOST@@`) && PathPrefix(`/account/v1/`)
      priority: 190
      entryPoints: [websecure]
      tls: {}
      middlewares: [browser-cors]
      service: gizpay
    gizway-sync:
      rule: Host(`@@CN_HOST@@`) && (Path(`/_sync/gizway`) || PathPrefix(`/_sync/gizway/`))
      priority: 180
      entryPoints: [websecure]
      tls: {}
      middlewares: [browser-cors, strip-gizway-sync]
      service: powersync-gizway
    gizpay-sync:
      rule: Host(`@@CN_HOST@@`) && (Path(`/_sync/gizpay`) || PathPrefix(`/_sync/gizpay/`))
      priority: 180
      entryPoints: [websecure]
      tls: {}
      middlewares: [browser-cors, strip-gizpay-sync]
      service: powersync-pay
  middlewares:
    browser-cors:
      headers:
        accessControlAllowOriginList: ["*"]
        accessControlAllowMethods: [GET, POST, PUT, PATCH, DELETE, OPTIONS]
        accessControlAllowHeaders: [Authorization, Content-Type, X-User-Agent]
        accessControlExposeHeaders: [Retry-After]
    strip-gizway-sync: {stripPrefix: {prefixes: [/_sync/gizway]}}
    strip-gizpay-sync: {stripPrefix: {prefixes: [/_sync/gizpay]}}
  services:
    gizpay: {loadBalancer: {servers: [{url: "@@GIZPAY_UPSTREAM@@"}]}}
    gizway: {loadBalancer: {servers: [{url: "@@GIZWAY_UPSTREAM@@"}]}}
    powersync-pay: {loadBalancer: {servers: [{url: "@@POWERSYNC_PAY_UPSTREAM@@"}]}}
    powersync-gizway: {loadBalancer: {servers: [{url: "@@POWERSYNC_GIZWAY_UPSTREAM@@"}]}}
