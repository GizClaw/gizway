tls:
  options:
    default:
      sniStrict: true
  certificates:
    - certFile: "@@TLS_CERT_FILE@@"
      keyFile: "@@TLS_KEY_FILE@@"
http:
  routers:
    ai:
      rule: Host(`@@GLOBAL_HOST@@`) && (PathPrefix(`/openai/`) || PathPrefix(`/anthropic/`) || PathPrefix(`/genai/`))
      priority: 200
      entryPoints: [websecure]
      tls: {}
      service: gizway
    auth-user:
      rule: Host(`@@GLOBAL_HOST@@`) && (Path(`/auth/runtime-config`) || Path(`/auth/catalog-token`) || PathPrefix(`/user/v1/`))
      priority: 190
      entryPoints: [websecure]
      tls: {}
      service: gizway
    account:
      rule: Host(`@@GLOBAL_HOST@@`) && PathPrefix(`/account/v1/`)
      priority: 190
      entryPoints: [websecure]
      tls: {}
      service: gizpay
    gizway-sync:
      rule: Host(`@@GLOBAL_HOST@@`) && PathPrefix(`/_sync/gizway/`)
      priority: 180
      entryPoints: [websecure]
      tls: {}
      middlewares: [strip-gizway-sync]
      service: powersync-gizway
    gizpay-sync:
      rule: Host(`@@GLOBAL_HOST@@`) && PathPrefix(`/_sync/gizpay/`)
      priority: 180
      entryPoints: [websecure]
      tls: {}
      middlewares: [strip-gizpay-sync]
      service: powersync-pay
    web:
      rule: Host(`@@GLOBAL_HOST@@`)
      priority: 1
      entryPoints: [websecure]
      tls: {}
      service: web
  middlewares:
    strip-gizway-sync: {stripPrefix: {prefixes: [/_sync/gizway]}}
    strip-gizpay-sync: {stripPrefix: {prefixes: [/_sync/gizpay]}}
  services:
    gizpay: {loadBalancer: {servers: [{url: "@@GIZPAY_UPSTREAM@@"}]}}
    gizway: {loadBalancer: {servers: [{url: "@@GIZWAY_UPSTREAM@@"}]}}
    web: {loadBalancer: {servers: [{url: "@@WEB_UPSTREAM@@"}]}}
    powersync-pay: {loadBalancer: {servers: [{url: "@@POWERSYNC_PAY_UPSTREAM@@"}]}}
    powersync-gizway: {loadBalancer: {servers: [{url: "@@POWERSYNC_GIZWAY_UPSTREAM@@"}]}}
